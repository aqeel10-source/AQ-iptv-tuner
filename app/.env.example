# AQ-IPTV Tuner — runtime secrets. NEVER commit this file. chmod 600.
# Copy this file to .env and fill in your values.
# Loaded by docker-compose via env_file: .env

# Shared secret for the /reload endpoint (used by the hourly refresh cron).
# Generate with: openssl rand -hex 32
RELOAD_TOKEN=your-random-secret-here

# Subscription credentials.
# For each subscription in config.json, add a pair here.
# Slug = subscription name uppercased, non-alphanumeric chars → underscore.
# Example: name "My Provider" → MY_PROVIDER_USERNAME / MY_PROVIDER_PASSWORD
SUB_PROVIDER_ONE_USERNAME=your-username
SUB_PROVIDER_ONE_PASSWORD=your-password

# Add more subscriptions as needed:
# SUB_PROVIDER_TWO_USERNAME=your-username
# SUB_PROVIDER_TWO_PASSWORD=your-password
